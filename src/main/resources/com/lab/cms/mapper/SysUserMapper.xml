<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
    SysUserMapper 的 XML 映射文件。

    ⚠️ 路径必须与接口包名一致：
      接口 com.lab.cms.mapper.SysUserMapper
      XML  src/main/resources/com/lab/cms/mapper/SysUserMapper.xml
      （MybatisConfig 里的扫描路径是 classpath*:com/lab/cms/mapper/*.xml）

    ⚠️ 手写 SQL 必须自己加 deleted = 0！
      MP 的 @TableLogic 只对 MP 自动生成的 SQL 生效（selectById / selectPage 等）。
      XML 里的 SQL 是原样执行的 —— 不加 deleted = 0 会查出已删除的数据。
      这是 MP 逻辑删除最容易踩的坑。
-->
<mapper namespace="com.lab.cms.mapper.SysUserMapper">

    <!--
        查询用户及其角色码集合与权限码集合。

        为什么用 GROUP_CONCAT：
          一个用户可能有多个角色、每个角色有多个权限。
          用 JOIN + GROUP_CONCAT 一次查出"角色码用逗号拼成的字符串"，
          比"先查角色列表、再逐个查权限"（N+1 查询）效率高得多。

        为什么用 DISTINCT：
          多个角色可能有重叠的权限（如主编和编辑都有 article:view），
          不去重会出现重复权限码。

        ⚠️ 用 IFNULL 兜底：
          LEFT JOIN 在"用户没有任何角色"时，GROUP_CONCAT 返回 NULL，
          而权限查询若要基于角色做 JOIN，会因为角色为空而查不到。
          这里用子查询写法，避免这个问题。
    -->
    <resultMap id="LoginUserResultMap" type="com.lab.cms.entity.SysUser">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="nickname" column="nickname"/>
        <result property="phone" column="phone"/>
        <result property="email" column="email"/>
        <result property="avatar" column="avatar"/>
        <result property="status" column="status"/>
        <result property="lastLoginTime" column="last_login_time"/>
    </resultMap>

    <!--
        按用户名查用户（含密码哈希，供登录比对）。
        ⚠️ 必须显式加 deleted = 0。
    -->
    <select id="selectByUsername" resultMap="LoginUserResultMap">
        SELECT id,
               username,
               password,
               nickname,
               phone,
               email,
               avatar,
               status,
               last_login_time
        FROM sys_user
        WHERE username = #{username}
          AND deleted = 0
        LIMIT 1
    </select>

    <!--
        查用户的角色码集合，返回以逗号分隔的字符串（如 "ROLE_AUTHOR"）。
        Service 层再 split 成 Set。
    -->
    <select id="selectRoleCodesByUserId" resultType="java.lang.String">
        SELECT GROUP_CONCAT(DISTINCT r.role_code)
        FROM sys_user_role ur
                 INNER JOIN sys_role r ON r.id = ur.role_id AND r.deleted = 0
        WHERE ur.user_id = #{userId}
          AND ur.deleted = 0
    </select>

    <!--
        查用户的权限码集合，返回以逗号分隔的字符串
        （如 "article:create,article:submit,article:view"）。
        Service 层再 split 成 Set。
    -->
    <select id="selectPermissionCodesByUserId" resultType="java.lang.String">
        SELECT GROUP_CONCAT(DISTINCT p.permission_code)
        FROM sys_user_role ur
                 INNER JOIN sys_role_permission rp ON rp.role_id = ur.role_id AND rp.deleted = 0
                 INNER JOIN sys_permission p ON p.id = rp.permission_id AND p.deleted = 0
        WHERE ur.user_id = #{userId}
          AND ur.deleted = 0
    </select>

</mapper>
