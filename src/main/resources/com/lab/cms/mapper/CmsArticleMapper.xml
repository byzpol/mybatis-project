<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
    CmsArticleMapper 的 XML 映射文件。

    ⚠️ 路径必须与接口包名一致：
      接口 com.lab.cms.mapper.CmsArticleMapper
      XML  src/main/resources/com/lab/cms/mapper/CmsArticleMapper.xml
      （MybatisConfig 里扫描的是 classpath*:com/lab/cms/mapper/*.xml）

    ⚠️ namespace 必须写全限定接口名，否则启动时报
      "Invalid bound statement (not found)"。

    ===========================================================================
    S07 说明：本文件在 S07 阶段只建骨架，不写任何 SQL
    ===========================================================================
    按开发手册要求，"这一版只写接口方法，XML 加 TODO 留到业务步骤再补"。
    此时若调用 CmsArticleMapper.selectIdTitleByKeyword(...) 会抛
      org.apache.ibatis.binding.BindingException: Invalid bound statement (not found)
    —— 这是<b>预期行为</b>，不是配置错误。等 S09 检索相关步骤补上 SQL 后即正常。

    ⚠️ 补 SQL 时的铁律（见 docs/S05-联调实测记录.md 与 BaseEntity 类注释）：
      手写 SQL 必须自己写 AND deleted = 0！
      MP 的 @TableLogic 只对 MP 自动生成的 SQL 生效，XML 原样执行。
      漏了这一句 = 查出已删除的文章，且不报错 —— 静默错数据。
-->
<mapper namespace="com.lab.cms.mapper.CmsArticleMapper">

    <!--
        按关键字模糊检索文章的 id 与标题（S09 补齐，S07 只留了 TODO）。

        ⚠️ 三条硬规则，逐条都能说出理由：
          1. 只 SELECT id, title 两列，不取 content（LONGTEXT）——
             全列查询会把整篇正文拖回来，浪费带宽与内存，而这个方法的使用场景
             （站点内检索下拉提示）只需要 id + title 两个字段。
          2. 必须自己写 AND deleted = 0 —— 见文件头与 CmsArticleMapper 类注释：
             @TableLogic 只作用于 MP 自动生成的 SQL，XML 是原样执行的，
             漏掉这一句会查出已删除的文章，且**不报任何错**。
          3. 关键字用 CONCAT('%', #{keyword}, '%')，绝不用 ${}
             —— ${} 是文本直接替换，会把入参拼进 SQL 文本，是最典型的注入面。
             这里 #{keyword} 走 PreparedStatement 占位符，安全。

        为什么显式写 LIMIT 100：
          本方法没有分页参数，若不加限制，模糊匹配到 10 万行就会全部拖回内存。
          这里用固定上限做兜底（检索下拉提示场景 100 条足够）；
          真正的分页检索走的是另一条路（Service 侧的 PageQuery + PageResult），
          不在本方法职责内 —— 这样区分是为了让"没有分页能力的查询"不可能被误用于列表页。
    -->
    <select id="selectIdTitleByKeyword" resultType="com.lab.cms.entity.CmsArticle">
        SELECT id,
               title
        FROM cms_article
        WHERE deleted = 0
          AND title LIKE CONCAT('%', #{keyword}, '%')
        ORDER BY id DESC
        LIMIT 100
    </select>
</mapper>
