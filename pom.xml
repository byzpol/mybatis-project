<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.lab</groupId>
    <artifactId>cms-mis</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>war</packaging>
    <name>cms-mis</name>
    <description>企业级 CMS 内容管理系统 - SSM(Spring 5.3.31 + SpringMVC + MyBatis-Plus 3.5.5) 全注解整合</description>

    <properties>
        <!-- ================= 环境基线 ================= -->
        <!-- JDK 21：本机 D:\develop\jdk\jdk-21.0.12.1+1 -->
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- ================= 统一版本管理 ================= -->
        <!--
            所有依赖版本集中在此声明。
            好处：① 升级只改一处 ② Code Review 时一眼看全版本矩阵
                 ③ 避免同一依赖在不同 dependency 里版本不一致
        -->
        <!-- Spring 5.3.31：课程指定版本。注意 5.x 用 javax.servlet，不是 jakarta -->
        <spring.version>5.3.31</spring.version>
        <!-- MyBatis-Plus 3.5.5：指导书写 3.5.3.1，但本地仓库只缓存 3.5.5（离线拿不到 3.5.3.1） -->
        <mybatis-plus.version>3.5.5</mybatis-plus.version>
        <druid.version>1.2.20</druid.version>
        <mysql.version>8.0.33</mysql.version>
        <jackson.version>2.15.3</jackson.version>
        <hibernate-validator.version>6.2.5.Final</hibernate-validator.version>
        <!-- Lombok 1.18.48：1.18.30 不兼容 JDK 25 的 javac（Maven 运行在 JDK 25 上） -->
        <lombok.version>1.18.48</lombok.version>
        <slf4j.version>1.7.36</slf4j.version>
        <logback.version>1.2.13</logback.version>
        <junit.version>4.13.2</junit.version>
    </properties>

    <dependencies>
        <!-- ==================================================== -->
        <!--                    一、Spring 核心                    -->
        <!-- ==================================================== -->

        <!-- Spring 上下文（IoC 容器、@Configuration、@Bean、事件等） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>${spring.version}</version>
        </dependency>

        <!-- Spring JDBC（DataSourceTransactionManager 在这里；纯 JDBC 模板也在） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
            <version>${spring.version}</version>
        </dependency>

        <!--
            Spring 声明式事务。
            ⚠️ 必须显式声明：@EnableTransactionManagement 与 @Transactional 注解
            定义在 spring-tx 中。虽然 spring-jdbc 会传递引入，但显式声明能让依赖关系更清晰，
            也避免传递依赖被优化掉时编译失败。
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
            <version>${spring.version}</version>
        </dependency>

        <!--
            Spring AOP 切面支持。
            ⚠️ 必须显式声明 spring-aspects：
            @RequirePermission 权限校验切面与 @OperLog 操作日志切面都依赖它。
            实验一未用到 AOP，故无此依赖；本项目新增。
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-aspects</artifactId>
            <version>${spring.version}</version>
        </dependency>

        <!--
            AspectJ 织入所需的注解支持。
            spring-aspects 会传递引入 aspectjweaver，此处不再单独声明，
            避免版本冲突。
        -->

        <!-- Spring Web MVC（DispatcherServlet、@RestController、@ExceptionHandler 等） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <version>${spring.version}</version>
        </dependency>

        <!-- Spring 测试支持（@RunWith(SpringJUnit4ClassRunner.class) 需要） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <version>${spring.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ==================================================== -->
        <!--                  二、持久层                           -->
        <!-- ==================================================== -->

        <!--
            MyBatis-Plus（内置 MyBatis 核心）。
            ⚠️ 此处刻意不直接声明 org.mybatis:mybatis：
            若同时声明，Maven 的"最近优先"调解规则会让直接声明的旧版本胜出，
            使 MP 运行在其预期之外的 MyBatis 上。
            统一由 MP 提供 MyBatis 核心，实际生效版本为 MP 3.5.5 传递来的 3.5.15。
            （此为实验一实测验证过的结论，勿改。）
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!--
            MyBatis-Spring 整合包。
            ⚠️ 必须显式声明：它提供 org.mybatis.spring.SqlSessionTemplate 与
            org.mybatis.spring.mapper.MapperScannerConfigurer，
            是把 MyBatis 的 SqlSession 纳入 Spring 事务体系的关键。
            mybatis-plus（非 spring-boot-starter 版）**不会**传递引入它，
            因此纯 SSM 手写配置必须自己声明，否则编译报"程序包 org.mybatis.spring 不存在"。

            版本选择：2.1.2 兼容 MyBatis 3.5.x 与 Spring 5.3.x。
            （2.0.x 也可用，但 2.1.x 对 MyBatis 3.5.9+ 的兼容性更好。）
        -->
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis-spring</artifactId>
            <version>2.1.2</version>
        </dependency>

        <!-- Druid 连接池（含监控 StatFilter；本项目不做监控页，但连接池本身必备） -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid</artifactId>
            <version>${druid.version}</version>
        </dependency>

        <!-- MySQL 驱动（MySQL 9.5 服务端，驱动用 8.0.33 实测兼容） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.version}</version>
        </dependency>

        <!-- ==================================================== -->
        <!--                  三、Web 与 JSON                      -->
        <!-- ==================================================== -->

        <!--
            Servlet API。
            ⚠️ 必须是 javax.servlet（4.0.1），不是 jakarta.servlet：
            Spring 5.3.x 与 Tomcat 9.x 都还在 javax 命名空间。
            scope=provided：Tomcat 容器已自带此 API，打进 war 会导致类冲突。
        -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>4.0.1</version>
            <scope>provided</scope>
        </dependency>

        <!--
            JSP / JSTL。
            本项目后端纯 REST（返回 JSON），不渲染视图，故不需要 JSP。
            【刻意不引入 jstl 与 JSP 依赖】：减少 war 体积，也明确"前后端分离"的架构立场。
            若后续需要少量服务端页面，再单独引入。
        -->

        <!-- Jackson：JSON 序列化（@RequestBody / @ResponseBody 的实际执行者） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!--
            Jackson JSR-310 模块。
            ⚠️ 必需：不引入它，java.time.LocalDateTime 会被序列化成 [2026,10,8,17,25,42] 数组。
            在 Spring Boot 里被自动配置掩盖了，纯 SSM 手写配置必须自己注册。
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- ==================================================== -->
        <!--                  四、参数校验                          -->
        <!-- ==================================================== -->

        <!-- Hibernate Validator（JSR-303/JSR-380 实现，提供 @NotNull/@NotBlank/@Size 等） -->
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
            <version>${hibernate-validator.version}</version>
        </dependency>

        <!--
            EL 实现。
            ⚠️ 必需：hibernate-validator 6.x 在运行时需要 EL 表达式实现来解析消息模板，
            缺失时会抛 HV000183: Unable to initialize 'javax.el.ExpressionFactory'。
            这是纯 SSM 环境（无 Spring Boot 自动带 EL）下最常见的校验坑。
        -->
        <dependency>
            <groupId>org.glassfish</groupId>
            <artifactId>jakarta.el</artifactId>
            <version>3.0.4</version>
        </dependency>

        <!-- ==================================================== -->
        <!--                  五、工具与日志                        -->
        <!-- ==================================================== -->

        <!--
            Lombok：编译期注解处理器。
            版本说明：1.18.30 虽为首个支持 JDK 21 的版本，但它直接操作 javac 内部 API，
            并不兼容 JDK 25；而本机 Maven 实际运行在 JDK 25 上（由 JAVA_HOME 决定），
            故必须选用同时兼容 JDK 21 与 JDK 25 的 1.18.48。
            scope=provided：编译期需要它生成字节码，运行期产物不依赖它。
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- SLF4J 门面：代码里只用 org.slf4j.Logger，不直接依赖 logback -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!--
            Logback 实现（替代实验一的 log4j 1.2.17）。
            理由：log4j 1.x 已停止维护且存在已知安全问题；logback 是 SLF4J 的原生实现，
            与 Spring 5.x 的日志体系天然打通（Spring 内部也用 spring-jcl + SLF4J）。
            若继续用 log4j 1.x，需要额外的 slf4j-log4j12 桥接包，反而更绕。
        -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>

        <!-- BCrypt 密码加密：spring-security-crypto 单独引入（不引整个 Spring Security） -->
        <!--
            说明：本项目鉴权用自研 @RequirePermission + Session，不用 Spring Security 框架，
            但密码哈希需要 BCrypt。spring-security-crypto 是一个独立的、无 Spring 依赖的小包，
            只提供 PasswordEncoder，引入成本极低，比自己手写 BCrypt 更安全。
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
            <version>5.8.10</version>
        </dependency>

        <!-- ==================================================== -->
        <!--                  六、测试                              -->
        <!-- ==================================================== -->

        <!--
            JUnit 4.13.2。
            ⚠️ 指导书明确指定 JUnit 4，不是 JUnit 5。
            理由：Spring 5.3 的 SpringJUnit4ClassRunner 与 JUnit 4 配套；
            换 JUnit 5 需额外引入 junit-vintage-engine 或改用 SpringExtension，
            与指导书的示例代码不一致，徒增理解成本。
        -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- war 包名固定为 cms-mis.war，便于 Tomcat 部署路径稳定（不随 version 变化） -->
        <finalName>cms-mis</finalName>

        <resources>
            <!--
                资源过滤：把 src/main/resources 下的文件打进 war。
                ⚠️ 排除 db.properties.example 与 .gitkeep 之类的辅助文件 ——
                它们是给开发者看的模板/占位，打进部署包没有意义且会让包体积变大。
                （db.properties 本身要打进去：那是运行期真正读取的配置。）
            -->
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>**/*.example</exclude>
                    <exclude>**/.gitkeep</exclude>
                    <exclude>**/*.md</exclude>
                </excludes>
            </resource>
        </resources>

        <plugins>
            <!--
                编译插件。
                关键点 1：显式锁 <release>21</release>。
                  原因：用户级 ~/.m2/settings.xml 中残留一个 jdk-17 profile，
                  其 activeByDefault=true 会无条件激活并把 maven.compiler.source/target
                  全局设为 17。按 Maven 参数解析规则，插件 <configuration> 中的显式配置
                  优先于 maven.compiler.* 属性，故在此显式声明即可保证编译级别为 21，
                  且无需修改全局 settings.xml（避免影响其他项目）。
                关键点 2：<arg>-proc:full</arg>。
                  JDK 23 起 javac 不再默认启用 classpath 上的注解处理器
                  （本机 Maven 运行在 JDK 25 上，故受影响）。
                  不加此项时 Lombok 不会被调用，编译仍会"成功"，
                  但 getter/setter 不会被生成——属于静默失效，极难察觉。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                    <encoding>UTF-8</encoding>
                    <compilerArgs>
                        <arg>-proc:full</arg>
                        <!-- 保留参数名信息，便于 SpringMVC 的 @RequestParam/@PathVariable 在
                             不显式指定 value 时也能按参数名匹配（Spring 5.3 需要 -parameters 或调试信息） -->
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!--
                war 打包插件。
                failOnMissingWebXml=false：本项目用 ServletContainersInitConfig（Java 配置类）
                代替 web.xml，必须显式关掉"缺少 web.xml 就报错"的检查。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>

            <!--
                资源文件拷贝时保留原编码。
                原因：Mapper XML 里有中文注释与中文参数默认值，
                默认平台编码（Windows 上是 GBK）会导致中文乱码。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- 测试插件：指定编码，避免测试类中的中文断言乱码 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <argLine>-Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
